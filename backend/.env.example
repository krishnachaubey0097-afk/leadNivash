# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/leadnivesh
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/leadnivesh

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_at_least_64_character_hex_string_for_access_token_secret
JWT_REFRESH_SECRET=replace_with_different_at_least_64_character_hex_string_for_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs / CORS ──────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173

# ── Encryption (AES-256-GCM: 32 bytes = 64 hex chars) ───────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_exact_64_character_hex_string_for_aes_256_gcm_key

# ── Google OAuth (optional, enabled when present) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── LLM (provider-agnostic) ──────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=10000
LLM_DAILY_BUDGET_INR=200
PARSE_MAX_CHARS=4000

# ── Media (Cloudinary) ───────────────────────────────────────────────────
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MEDIA_MAX_PHOTOS=4
MEDIA_MAX_BYTES=2000000

# ── Email (SMTP / Gmail App Password / Resend) ────────────────────────────
# Option A (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=leadnivash@gmail.com, SMTP_PASS=<16-char-app-password>
# Option B (Resend): SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASS=<resend-api-key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=leadnivash@gmail.com
SMTP_PASS=your_gmail_app_password_or_smtp_key
SMTP_FROM="LeadNivash <leadnivash@gmail.com>"
EMAIL_FROM=noreply@leadnivesh.com
FOUNDER_ALERT_EMAIL=founder@leadnivesh.com

# ── Web Push (P1) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@leadnivesh.com

# ── Plans / Limits ───────────────────────────────────────────────────────
TRIAL_DAYS=14

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=

