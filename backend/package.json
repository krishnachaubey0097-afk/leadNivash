{
  "name": "leadnivesh-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for LeadNivesh",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mem": "tsx scripts/devWithMemoryDb.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "eval": "tsx eval/runEval.ts",
    "eval:llm": "tsx eval/runEval.ts --llm",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "seed": "tsx scripts/seedDatabase.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@sentry/node": "^11.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.16",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.0",
    "typescript": "^7.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
